covariates = c("C.1", "C.2", "C.3"),
learners = c("SL.glm"),
num_folds = 1)
, envir = environment())
length(mediators)
#### R Code for Running the Mediated-Moderation Analysis with Two Mediators ####
library(tidyverse)
library(glue)
library(origami)
library(mvtnorm)
library(SuperLearner)
library(ranger)
library(gam)
library(nnet)
# Import data
