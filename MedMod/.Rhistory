# run ----------
out <- MedMod(data = data,
outcome = "Outcome",
mediators = c("M1", "M2"),
treatment = "Intervention",
subgroup = "Male",
covariates = c("C.1", "C.2", "C.3"),
learners = c("SL.glm"),
num_folds = 1,
ci.level = 0.95)
