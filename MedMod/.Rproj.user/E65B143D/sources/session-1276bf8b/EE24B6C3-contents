one.jj <- function (jj = 1) {
  Fit <- as.character(methds$Fit[jj])
  fity.interact <- methds$fity.interact[jj]
  fitm.interact <- methds$fitm.interact[jj]
  Yfamily <- ifelse(length(unique(data_in[[Yname]])) > 2, "gaussian", "binomial")
  Mfamily <- ifelse(max( map_dbl(Mediators, ~length(unique(data_in[[.]]))) ) > 2, "gaussian", "binomial")

  max( map_dbl(Mediators, ~length(unique(data_in[[.]]))) ) > 2
  if (Fit == "glm") {
    learners <- learners_a <- learners_m <- learners_y <- c("SL.glm")
    num_folds <- 1
  }
  if (Fit == "mlr") {
    # learners <- c("SL.ranger", "SL.glm", "SL.glm.interaction", "SL.xgboost")
    learners <- c("SL.glm", "SL.glm.interaction", "SL.ranger", "SL.nnet")
    learners <- c("SL.glm", "SL.nnet")
    learners <- c("SL.glm", "SL.mean", "SL.ranger", "SL.nnet")
    learners_h <- learners
    learners_mu <- learners
    num_folds <- 4
